# Copy to .env (chmod 600) and fill in. .env is git-ignored.
LC_USER=viewer
LC_PASS=change-me-to-a-long-random-string

# Bind to the Pi's Tailscale IP so it is not reachable on the LAN. 0.0.0.0 = all interfaces.
LC_BIND=100.72.27.74
LC_PORT=5070

# "auto" picks /dev/v4l/by-id/*-video-index0. Or a device path, index, or a video file for testing.
CAMERA_SOURCE=auto
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=10

LC_DATA_DIR=./data
RETENTION_DAYS=90
MIN_FREE_GB=15
REPEAT_SEC=300

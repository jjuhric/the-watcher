# Copy to .env (chmod 600) and fill in. .env is git-ignored.
LC_USER=viewer
LC_PASS=change-me-to-a-long-random-string

# Listen on localhost and publish it with: tailscale serve --bg --https=5070 http://127.0.0.1:5070
LC_BIND=127.0.0.1
LC_PORT=5070

# Passkeys (fingerprint / Windows Hello): your tailscale serve https address
LC_RP_ID=your-pi.your-tailnet.ts.net
LC_ORIGINS=https://your-pi.your-tailnet.ts.net:5070

# "auto" picks /dev/v4l/by-id/*-video-index0. Or a device path, index, or a video file for testing.
CAMERA_SOURCE=auto
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=10

# Cut power to the camera USB port when it is switched off (needs uhubctl + deploy/99-watcher-usb-power.rules)
LC_USB_POWER=1

LC_DATA_DIR=./data
RETENTION_DAYS=90
MIN_FREE_GB=15
REPEAT_SEC=300
